# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-50-character-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Distinct from SECRET_KEY so a leak of one does not compromise both.
JWT_SIGNING_KEY=change-me-use-a-different-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://pharmagros:pharmagros@localhost:5432/pharmagros
DB_CONN_MAX_AGE=60

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Frontend / CORS ------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Security -------------------------------------------------------------
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
SESSION_COOKIE_AGE=28800

# --- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@pharmagros.bi

# --- Business -------------------------------------------------------------
# Burundi standard VAT. Set per-product overrides for exempt medicines.
DEFAULT_VAT_RATE=18.00

# Printed verbatim in the invoice header, so these must match the
# registration details the OBR holds for the taxpayer.
COMPANY_NAME=VISION PHARMA PLUS
COMPANY_NIF=4001902867
COMPANY_RC=35325/22
COMPANY_ADDRESS=MUKAZA ; AVENUE DU COMMERCE
COMPANY_PHONE=+257 68 606 080
COMPANY_EMAIL=visionpharmaplus@gmail.com
COMPANY_VAT_REGISTERED=true
COMPANY_TAX_CENTRE=DPMC
COMPANY_SECTOR=PHARMACIE DE GROS
COMPANY_LEGAL_FORM=SPRL

# Bank accounts printed under the totals, one per currency.
# Use the code USD rather than the "$" symbol: django-environ reads a
# leading "$" as a reference to another variable and recurses.
COMPANY_BANK_1_NAME=BCAB A/C NO
COMPANY_BANK_1_NUMBER=20103972201
COMPANY_BANK_1_CURRENCY=BIF
COMPANY_BANK_2_NAME=BCAB A/C NO
COMPANY_BANK_2_NUMBER=20203972201
COMPANY_BANK_2_CURRENCY=USD

# --- OBR electronic invoicing (EBMS) --------------------------------------
# Off by default. Turn it on only once the OBR has certified this
# installation and issued OBR_SYSTEM_ID: enabling it earlier queues documents
# that cannot be accepted, and every posted invoice would pile up undeclared.
OBR_ENABLED=false

# Point at the sandbox while testing; production has its own host and its own
# credentials. Endpoint paths are overridable because the OBR has moved them
# before, and a relocation should not require a code release.
OBR_BASE_URL=https://ebms.obr.gov.bi:9443/ebms_api
OBR_USERNAME=
OBR_PASSWORD=
OBR_PATH_LOGIN=login
OBR_PATH_ADD_INVOICE=addInvoice
OBR_PATH_CANCEL_INVOICE=cancelInvoice
OBR_PATH_CHECK_TIN=checkTIN

# Issued by the OBR on certification. It forms the second segment of every
# fiscal signature, so declaration cannot start without it.
OBR_SYSTEM_ID=

# Connect and read timeouts are separate: a slow response is normal on this
# link, while a slow connect means the host is unreachable.
OBR_CONNECT_TIMEOUT=10
OBR_READ_TIMEOUT=30

# After this many failed attempts a document stops being retried and is
# raised to a human instead.
OBR_MAX_ATTEMPTS=6

# Documents dated before go-live were filed by whatever process preceded this
# one and must not be declared twice. Leave blank to declare everything.
OBR_START_DATE=

# 1 = natural person, 2 = legal person.
OBR_TAXPAYER_TYPE=2
OBR_VAT_SUBJECT=true
OBR_CONSUMPTION_TAX_SUBJECT=false
OBR_WITHHOLDING_TAX_SUBJECT=false
OBR_TRADE_REGISTER=35325/22

# The OBR records an address as separate administrative divisions rather than
# the single free-text line printed on the invoice, so these are set apart
# from COMPANY_ADDRESS above and must match the taxpayer's registration.
OBR_ADDRESS_PROVINCE=BUJUMBURA MAIRIE
OBR_ADDRESS_COMMUNE=MUKAZA
OBR_ADDRESS_QUARTIER=
OBR_ADDRESS_AVENUE=DU COMMERCE
OBR_ADDRESS_RUE=
OBR_ADDRESS_NUMBER=

# --- Observability --------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMATTER=plain
SENTRY_DSN=
ENVIRONMENT=development

# --- docker compose only --------------------------------------------------
# Read by docker-compose.yml, not by Django. Ignore these when running the
# backend directly with manage.py.
POSTGRES_DB=pharmagros
POSTGRES_USER=pharmagros
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# The frontend is a separate repository. FRONTEND_IMAGE is a tag published
# from it; NGINX_CONF_DIR is a path to that repo's docker/nginx directory.
FRONTEND_IMAGE=ghcr.io/OWNER/pharmagros-frontend:latest
NGINX_CONF_DIR=../pharmagros-frontend/docker/nginx
